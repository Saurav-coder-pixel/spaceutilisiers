# ===================================================================
#   SPACE UTILIZERS — Environment Variables (ROOT)
#   These apply to the FRONTEND (Vite) build + dev server.
#   Backend (email) credentials live in ./server/.env
# ===================================================================

# -------------------------------------------------------------------
# 1. FRONTEND — Vite dev server proxy target
#    Where the backend email API runs during `npm run dev`
# -------------------------------------------------------------------
BACKEND_TARGET=http://localhost:4000

# -------------------------------------------------------------------
# 2. FRONTEND — Explicit contact API endpoint (optional)
#    If set, OVERRIDES all auto-detection. Use this when:
#    - Backend is hosted on a DIFFERENT domain than frontend
#    - Deploying to Hostinger static hosting + separate Node server
#      Example:
#        VITE_CONTACT_API_URL=https://api.spaceutilizers.com/api/contact
#    Leave empty for same-origin / Vercel / Netlify auto-detect.
# -------------------------------------------------------------------
# VITE_CONTACT_API_URL=
