# =====================================================================
# SPACE UTILIZERS — Backend Email Server Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the `.env` file to version control.
# =====================================================================

# ── Server ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
# If left blank, defaults to localhost + *.spaceutilizers.com + Vercel/Netlify subdomains
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://spaceutilizers.com

# Public site URL (used in emails)
WEBSITE_URL=https://spaceutilizers.com

# ── Company / Branding ──────────────────────────────────────────────
COMPANY_NAME=Space Utilizers

# ── Email Addresses ─────────────────────────────────────────────────
# Admin inbox that receives new contact inquiries
ADMIN_EMAIL=hello@spaceutilizers.com

# Address used as the sender (must be verified in your SMTP / Resend / SendGrid account)
FROM_EMAIL=no-reply@spaceutilizers.com
FROM_NAME=Space Utilizers

# Address used for user auto-reply "reply-to" header (typically same as ADMIN_EMAIL)
REPLY_TO_EMAIL=hello@spaceutilizers.com

# ══════════════════════════════════════════════════════════════════════
#   EMAIL PROVIDER — Choose ONE of the following
# ══════════════════════════════════════════════════════════════════════
# Set EMAIL_PROVIDER to one of:   smtp  |  resend  |  sendgrid

EMAIL_PROVIDER=smtp

# ── Option A — SMTP (works with Gmail, Outlook, cPanel/WHM, SES SMTP, etc.) ──
# Example for Gmail (requires App Password if 2FA is enabled):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your-app-password
#
# Example for Hostinger / cPanel:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=no-reply@spaceutilizers.com
#   SMTP_PASS=********
#
# Example for AWS SES SMTP:
#   SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=AKIA....
#   SMTP_PASS=.....

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Option B — Resend (https://resend.com) ──────────────────────────
# Generate an API key from:  https://resend.com/api-keys
RESEND_API_KEY=

# ── Option C — SendGrid (Twilio) ────────────────────────────────────
# Generate an API key from:  https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
